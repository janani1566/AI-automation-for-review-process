# ========================================================
# AI-Powered Intern Task Review and Feedback Automation
# Environment Configuration (.env.example)
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# 1. AI Provider Configuration
# Options: 'mock' (default, safe for demo) | 'openai'
AI_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 2. Email Service Configuration
# Options: 'mock' (default, safe for demo - records in outbox) | 'smtp'
EMAIL_MODE=mock
EMAIL_FROM=intern-automation@example.com
SUPERVISOR_EMAIL=supervisor@example.com

# SMTP Details (Required only if EMAIL_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# 3. Google Sheets Integration (Optional for Live Drive Sync)
# The application includes a CSV exporter out of the box.
# If connecting live Google Sheets API:
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
